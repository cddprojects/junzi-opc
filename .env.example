# Copy to .env.local (gitignored). Do not commit real secrets.

# Admin
ADMIN_PASSWORD=junzi-admin
VERIFY_SECRET=

# Public site URL used for Billplz callback_url and redirect_url.
# Billplz servers cannot reach 127.0.0.1 — live fulfillment needs a public HTTPS URL (or a tunnel).
NEXT_PUBLIC_APP_URL=http://127.0.0.1:43180

# Billplz API v3 (server only — never expose to the browser)
# Prefer pasting keys on /admin/billplz. That page writes this file.
BILLPLZ_API_KEY=
BILLPLZ_COLLECTION_ID=
BILLPLZ_X_SIGNATURE_KEY=
# false / omitted = production www.billplz.com. Set true only for sandbox testing.
BILLPLZ_SANDBOX=false

# Offline only. Default off. When true and Billplz is not configured, checkout can still issue a course code.
ALLOW_DEMO_PAY=false

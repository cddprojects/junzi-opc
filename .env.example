# Copy to .env.local (gitignored). Do not commit real secrets.

# --- Supabase (required on Vercel / production) ---
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Postgres URI from Supabase → Settings → Database (use the URI, ssl required)
DATABASE_URL=
# Unused in v1 (service-role only). Optional.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Course HMAC. Required on Vercel/production. Env only — never stored in the database.
VERIFY_SECRET=

# Admin
ADMIN_PASSWORD=junzi-admin

# Public site URL used for Billplz callback_url and redirect_url.
# Prefer NEXT_PUBLIC_SITE_URL; NEXT_PUBLIC_APP_URL is still read as a fallback in code.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:43180
NEXT_PUBLIC_APP_URL=http://127.0.0.1:43180

# Billplz API v3 (server only — never expose to the browser)
BILLPLZ_API_KEY=
BILLPLZ_COLLECTION_ID=
BILLPLZ_X_SIGNATURE_KEY=
BILLPLZ_SANDBOX=false

# Offline only. Default off.
ALLOW_DEMO_PAY=false
